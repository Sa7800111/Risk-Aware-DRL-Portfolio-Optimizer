import time

class MasterExecutionLoop:
    def __init__(self, feed, discovery, sync, router, agent, assembler):
        self.feed = feed
        self.discovery = discovery
        self.sync = sync
        self.router = router
        self.agent = agent
        self.assembler = assembler

    def tick(self, ticker: str):
        mkt = self.feed.get_latest_state(ticker)
        nlp = self.discovery.fetch_nlp_tensor(ticker)
        port = self.sync.get_real_state()
        state = self.assembler.build(mkt, nlp, port)
        action, _, _ = self.agent.select_action(state, deterministic=True)
        self.router.route_action(ticker, action[0], mkt[0])
class SystemWatchdog:
    def __init__(self, max_latency=1.0):
        self.max_latency = max_latency

    def check_loop_health(self, start_time):
        if time.time() - start_time > self.max_latency:
            print("WARNING: Execution Loop Lag Detected.")
            return False
        return True
