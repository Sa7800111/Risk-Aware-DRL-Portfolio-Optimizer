class OutOfSampleBacktester:
    def __init__(self, agent, env):
        self.agent = agent
        self.env = env
        self.results = []

    def run_backtest(self, episodes=1):
        for ep in range(episodes):
            state, _ = self.env.reset()
            done = False
            ep_pnl = []
            while not done:
                with torch.no_grad():
                    action, _, _ = self.agent.select_action(state, deterministic=True)
                state, reward, done, _, info = self.env.step(action)
                ep_pnl.append(reward)
            self.results.append(ep_pnl)
        return np.array(self.results)
class SharpeCalculator:
    def __init__(self, risk_free_rate=0.02, periods=252):
        self.rf = risk_free_rate
        self.periods = periods

    def compute(self, returns_series):
        excess_returns = returns_series - (self.rf / self.periods)
        mean_return = np.mean(excess_returns)
        std_return = np.std(excess_returns)
        if std_return == 0:
            return 0.0
        return (mean_return / std_return) * np.sqrt(self.periods)
    class SortinoCalculator:
    def __init__(self, target_return=0.0, periods=252):
        self.target = target_return
        self.periods = periods

    def compute(self, returns_series):
        downside_returns = returns_series[returns_series < self.target]
        expected_return = np.mean(returns_series) - self.target
        downside_std = np.sqrt(np.mean(downside_returns**2))
        if downside_std == 0:
            return 0.0
        return (expected_return / downside_std) * np.sqrt(self.periods)
    class DrawdownAnalyzer:
    def calculate_mdd(self, portfolio_values):
        peak = portfolio_values[0]
        max_dd = 0.0
        for value in portfolio_values:
            if value > peak:
                peak = value
            dd = (peak - value) / peak
            if dd > max_dd:
                max_dd = dd
        return max_dd
    class TradeAnalyzer:
    def compute_win_rate(self, trades):
        wins = sum(1 for t in trades if t['pnl'] > 0)
        return wins / len(trades) if trades else 0.0

    def compute_profit_factor(self, trades):
        gross_profit = sum(t['pnl'] for t in trades if t['pnl'] > 0)
        gross_loss = abs(sum(t['pnl'] for t in trades if t['pnl'] < 0))
        return gross_profit / gross_loss if gross_loss > 0 else float('inf')
