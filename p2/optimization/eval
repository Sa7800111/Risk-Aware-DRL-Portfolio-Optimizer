class AlphaBetaAttribution:
    def run_regression(self, port_returns, benchmark_returns):
        x = sm.add_constant(benchmark_returns)
        model = sm.OLS(port_returns, x).fit()
        return {"alpha": model.params[0], "beta": model.params[1]}
