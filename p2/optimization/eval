class ActionRouter:
    def __init__(self, mars_gateway):
        self.gateway = mars_gateway

    def route_action(self, ticker: str, action_val: float, mid_price: float):
        if abs(action_val) < 0.1:
            return False
        side = 1 if action_val > 0 else -1
        qty = int(abs(action_val) * 100)
        order_data = {"side": side, "price": mid_price, "qty": qty, "type": 2}
        return self.gateway.handle_request(ticker, order_data)
