class ValueAtRisk:
    def calculate_parametric_var(self, returns, confidence=0.95):
        mu = np.mean(returns)
        sigma = np.std(returns)
        return norm.ppf(1 - confidence, mu, sigma)

    def calculate_cvar(self, returns, confidence=0.95):
        var = self.calculate_parametric_var(returns, confidence)
        return np.mean(returns[returns <= var])
